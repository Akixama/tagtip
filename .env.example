PORT=4173
# Random secret, at least 32 characters. Placeholder/short secrets disable operations.
# Send it as: Authorization: Bearer <value>
X_PROCESSOR_SECRET=replace-with-a-long-random-secret

# When set, the app automatically uses Neon/Postgres instead of the local JSON store.
DATABASE_URL=postgresql://user:password@host/database
X_BEARER_TOKEN=
APP_ORIGIN=http://localhost:4173
X_CLIENT_ID=
X_CLIENT_SECRET=
# Register APP_ORIGIN + /api/auth/x/callback as the exact X callback URL.
X_PROCESSOR_ENABLED=false
X_BOT_USER_ID=
X_BOT_HANDLE=TagTip
# Dedicated 32-byte AES key encoded as 64 hexadecimal characters. Never commit the real key.
X_BOT_TOKEN_ENCRYPTION_KEY=
# OAuth user access token belonging only to the bot account. Keep replies disabled until write access is live-tested.
X_BOT_USER_ACCESS_TOKEN=
X_REPLY_ENABLED=false
# Set to a recent post ID BEFORE enabling, to avoid processing historical commands.
X_START_SINCE_ID=
SOLANA_RPC_URL=https://api.devnet.solana.com
DEVNET_TREASURY_OWNER=
DEVNET_TREASURY_TOKEN_ACCOUNT=
# These configure a read-only evidence verifier. Deposits are NOT credited.
