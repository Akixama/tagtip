PORT=4173
# Required outside local demo mode. Send it as: Authorization: Bearer <value>
X_PROCESSOR_SECRET=replace-with-a-long-random-secret

# When set, the app automatically uses Neon/Postgres instead of the local JSON store.
DATABASE_URL=postgresql://user:password@host/database
X_BEARER_TOKEN=
APP_ORIGIN=http://localhost:4173
X_CLIENT_ID=
X_CLIENT_SECRET=
# Register APP_ORIGIN + /api/auth/x/callback as the exact X callback URL.
SOLANA_RPC_URL=https://api.devnet.solana.com
