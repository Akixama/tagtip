X_PROCESSOR_SECRET=replace-with-a-long-random-secret

# Production integrations (not consumed by the local demo yet)
DATABASE_URL=postgresql://user:password@host/database
X_BEARER_TOKEN=
SOLANA_RPC_URL=https://api.devnet.solana.com
